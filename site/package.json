{
  "name": "imkan-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The redesigned Imkan.ai website: static HTML pages built with Vite and the design-taste-frontend kit (ADR 0002).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
